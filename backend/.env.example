PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=med_tracker
JWT_SECRET=your_jwt_secret_key_here

# Distributed Rate Limiting (Redis / AWS ElastiCache / Kubernetes Valkey)
# Leave empty or omitted to use resilient in-memory fallback
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively, specify a full connection URI:
# REDIS_URL=redis://:password@redis-cluster.internal:6379

# ── Railway / Production ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (CORS).
# Set to your Railway frontend URL after deployment, e.g.:
# ALLOWED_ORIGINS=https://medtracker-frontend.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000

# Public URL of this backend service (used in CSP connect-src).
# Set to your Railway backend public URL after deployment, e.g.:
# BACKEND_URL=https://medtracker-backend.up.railway.app
FRONTEND_URL=http://localhost:3000

